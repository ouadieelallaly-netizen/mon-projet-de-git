
// Liste des compétences avec leur code et leur description
const competences = [
  { code: "C1", description: "Identifier et analyser les besoins" },
  { code: "C2", description: "Concevoir des solutions adaptées" },
  { code: "C3", description: "Développer des solutions informatiques" },
  { code: "C4", description: "Tester et valider les solutions" },
  { code: "C5", description: "Gérer un projet informatique" },
  { code: "C6", description: "Travailler en équipe et communiquer" },
  { code: "C7", description: "Assurer la sécurité informatique" },
  { code: "C8", description: "Développer ses compétences professionnelles" }
];

// Fonction pour mélanger les éléments d’un tableau (méthode de Fisher-Yates)
function melanger(tableau) {
  for (let i = tableau.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [tableau[i], tableau[j]] = [tableau[j], tableau[i]];
  }
}

// On mélange la liste des compétences
melanger(competences);

// Initialisation du score
let score = 0;

// Message d'accueil
console.log("🎓 Jeu éducatif : Mémoriser les compétences C1 à C8 !");
console.log("💡 Pour chaque description, entre le code correspondant (ex : C1, C2...).");

// Boucle sur chaque compétence
for (let i = 0; i < competences.length; i++) {
  // On pose la question à l'utilisateur
  let reponse = prompt(`👉 Quel est le code de cette compétence : "${competences[i].description}" ?`);
  
  // On nettoie la réponse (majuscule + sans espaces)
  reponse = reponse.toUpperCase().trim();

  // Vérification de la réponse
  if (reponse === competences[i].code) {
    console.log("✅ Bonne réponse !");
    score++;
  } else {
    console.log(`❌ Mauvaise réponse. La bonne réponse était : ${competences[i].code}`);
  }
}

// Affichage du score final
console.log(`🏁 Fin du jeu ! Ton score : ${score} / ${competences.length}`);



 
